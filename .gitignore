# środowisko wirtualne – każdy tworzy własne z requirements.txt
.venv/

# pliki generowane przez Pythona
__pycache__/
*.pyc

# ustawienia edytora (osobiste, nie projektowe)
.vscode/
.idea/

# cache narzędzi
.pytest_cache/

# sprawozdanie i notatki prywatne (nie w repozytorium)
reports/sprawozdanie.*
reports/odpowiedz_ustna.md

# wyniki działania programu – da się je odtworzyć skryptem
output/
data/

# pliki systemowe macOS
.DS_Store

# narzędzia AI (osobiste ustawienia asystentów)
.claude/
CLAUDE.md
.cursor/
.cursorrules